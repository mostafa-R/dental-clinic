# AdminDashboard environment
#
# Vite only exposes variables prefixed with VITE_ to the browser bundle, and
# they are inlined at BUILD time. Changing any of these requires a rebuild.
# Copy to `.env` (local) or set them in your host's dashboard (production).

# ---------------------------------------------------------------------------
# Local development
# ---------------------------------------------------------------------------
# Point straight at the API. Use the full origin in development so the browser
# talks to the backend directly and you get real CORS + cookie behaviour.
VITE_API_BASE_URL=http://localhost:7000/api/v1/site

# ---------------------------------------------------------------------------
# Production
# ---------------------------------------------------------------------------
# RECOMMENDED: keep the base RELATIVE and let the platform reverse-proxy it.
#
#   VITE_API_BASE_URL=/api/v1/site
#
# Then set BACKEND_API_URL (not VITE_*) on the host. AdminDashboard/middleware.js
# forwards /api/* and /socket.io/* to that origin, so the bundle stays
# same-origin: no CORS preflight and the HttpOnly session cookie is first-party.
# This is what the CI build uses.
#
# ALTERNATIVE: skip the proxy and point the bundle at the API origin directly.
# Set VITE_API_BASE_URL=https://api.your-domain.com/api/v1/site at build time.
# This requires the backend to send permissive CORS headers AND
# `credentials: true` cookies with an explicit domain, and Secure/HttpOnly/SameSite
# set appropriately for a cross-site cookie. Prefer the reverse proxy.

# Backend origin used by middleware.js for the reverse proxy. Server-side only;
# never prefixed with VITE_ and never exposed to the browser.
BACKEND_API_URL=https://api.your-domain.com

# Public URL of a clinic tenant, used for the "open clinic" link.
VITE_CLINIC_URL=https://clinic.your-domain.com

# Websocket endpoint. Leave unset to derive it from the page origin, which is
# correct when the socket is served through the same reverse proxy as /api/*.
# Set only if the socket lives on a different origin than the page.
# VITE_SOCKET_URL=https://api.your-domain.com
