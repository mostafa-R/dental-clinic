# Copy to .env and fill in real values. Never commit .env.
#
# Vite inlines every VITE_* variable into the built bundle, so anything here is
# PUBLIC — readable by anyone who opens the deployed JS. Never put a secret,
# API key, or database URL in this file. Anything sensitive belongs in the
# server's env, not the client's.

# ---- API base URL ----
# Relative by default: requests go to the same origin as the app and are
# forwarded by middleware.ts (see vercel.json, which excludes /api/ from the SPA
# rewrite). This is the right value for Vercel where the client and serverless
# API share a domain.
VITE_API_URL=/api/v1

# ---- WebSocket URL ----
# Socket.IO needs a long-lived Node process, which a Vercel serverless function
# is not: the connection dies on every deploy and cold starts. Point this at a
# separate always-on host (VPS, Render, Railway, Fly) once you have one.
#
# The fallback strips a trailing /api or /api/v1 from VITE_API_URL, so leaving
# this unset tries to use the same host. That works in local development and
# fails silently-ish in production — the app degrades to polling/toasts and no
# live updates. Set it explicitly.
# VITE_SOCKET_URL=https://api.dentalos.app

# ---- WhatsApp ----
# Number shown on the plan subscribe buttons: country code + number, digits only,
# no "+" or spaces. Unset hides the buttons.
# VITE_WHATSAPP_NUMBER=201012345678
VITE_WHATSAPP_NUMBER=201003140039