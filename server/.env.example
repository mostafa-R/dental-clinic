# Copy to .env and fill in real values. Never commit .env.
PORT=7000
# Local dev fallback:
# MONGO_URI=mongodb://127.0.0.1:27017/dental-clinic
# Atlas / production URI with a dedicated DB user (never reuse app secrets):
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.example.mongodb.net/dental_os?appName=Cluster0

# 64 random bytes as 128 hex chars each — run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Use four DIFFERENT values.
JWT_SECRET=REPLACE_WITH_128_HEX
# Per-token-family override, used in preference to the blanket secret above.
# Optional; leave unset to keep JWT_SECRET as the single source.
# JWT_ACCESS_SECRET=REPLACE_WITH_128_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_128_HEX
JWT_2FA_SECRET=REPLACE_WITH_ANOTHER_128_HEX
# Signs short-lived, single-use impersonation grants. REQUIRED in production —
# a server will refuse to start impersonation without it, so a compromised
# session secret cannot be used to mint clinic access.
JWT_IMPERSONATION_SECRET=REPLACE_WITH_A_4TH_128_HEX
# 32 random bytes as 64 hex chars (site recovery bypass):
SITE_RECOVERY_KEY=REPLACE_WITH_64_HEX
ACCESS_TOKEN_EXPIRY=1h
REFRESH_TOKEN_EXPIRY=7d
CLIENT_URL=http://localhost:5173,http://localhost:5174

NODE_ENV=production

# ---- At-rest encryption (PHI) ----
# 32 random bytes as 64 hex chars. Encrypts sensitive patient fields.
# CHANGING THIS MAKES EXISTING ENCRYPTED FIELDS UNREADABLE — rotate via a
# re-encryption migration, never by editing the value.
ENCRYPTION_KEY=REPLACE_WITH_64_HEX

# 32 random bytes as 64 hex chars. HMAC key for signed patient-consent records.
CONSENT_SIGNING_KEY=REPLACE_WITH_64_HEX

# ---- Audit chain integrity ----
# HMAC key for the audit-log hash chain. Falls back to BACKUP_ENCRYPTION_KEY and
# then JWT_SECRET, so set it explicitly to decouple rotation of the audit chain
# from the other secrets. CHANGING IT INVALIDATES EXISTING CHAIN LINKS.
AUDIT_CHAIN_SECRET=REPLACE_WITH_64_HEX
# How many divergent branches to retain so a legitimate fork (restored backup,
# out-of-order write) can be reconciled instead of failing the whole chain.
AUDIT_CHAIN_KEEP_FORKS=5

# ---- Reverse proxy / host policy (production) ----
# Comma-separated hosts the API answers to, beyond APP_DOMAIN. Do not use a
# leading wildcard.
APP_DOMAIN=dentalos.app
# ALLOWED_EXTRA_HOSTS=api.dentalos.app,staging.dentalos.app
# IPs/CIDRs of proxies allowed to set X-Forwarded-*. Empty = trust any proxy,
# which is only safe when nothing but your proxy can reach the port.
TRUSTED_PROXY_IP=
# Client-IP derivation for the websocket connection cap. Defaults to true when
# NODE_ENV=production; set false when the app is exposed directly.
TRUST_PROXY=true

# Number of proxy hops to trust when deriving the client IP. Set this when your
# platform sits behind another proxy (e.g. a CDN in front of Vercel); leave unset
# when it does not apply. Over-trusting lets a client spoof X-Forwarded-For and
# bypass the per-IP websocket cap and the rate limiter.
# TRUST_PROXY_HOPS=1

# 2FA re-prompt window for privileged site-admin actions.
SITE_2FA_MAX_AGE_SECONDS=900

# ---- Alerting thresholds (optional) ----
# ALERT_RESPONSE_MS=2000
# ALERT_MEMORY_PCT=90
# ALERT_ERROR_RATE_PCT=5
# ALERT_TENANT_SPIKE=50
# ALERT_QUOTA_RATE=90

# Expose Swagger/OpenAPI at /api/docs. Keep false in production.
ENABLE_API_DOCS=false

# Default IANA timezone for tenant reporting (e.g. Africa/Cairo).
# APP_DEFAULT_TZ=UTC

# redis://[:password@]host:port
REDIS_URL=redis://127.0.0.1:6379

BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPT=true
# 32 random bytes as 64 hex chars. Rotating this invalidates existing encrypted backups.
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_64_HEX

# First-time seed of the site admin (super_admin). Rotating this does NOT change an
# already-seeded admin's password — update that account in the DB instead.
SEED_SITEADMIN_EMAIL=siteadmin@example.com
SEED_SITEADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
SEED_BOOTSTRAP_2FA=false

# Older name for the first platform super_admin seed. If both pairs are set the
# SITEADMIN pair wins; set only whichever your database already uses, or the
# seed will skip an admin that is already there.
# SEED_SUPERADMIN_EMAIL=siteadmin@example.com
# SEED_SUPERADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ---- WhatsApp (patient messaging) ----
# Off unless you configure it. Keep off when you have no persistent Node host:
# the Baileys session needs a long-lived process, and an ephemeral serverless
# function will drop the connection and rate-limit on every deploy.
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=whatsapp_web
# Subset of 10 WhatsApp Cloud API templates per 24h. Unused by the web provider.
WHATSAPP_DEFAULT_COUNTRY=EG
WHATSAPP_MAX_CONNECTED=5
# How long a live-template/message send waits before giving up.
WA_LIVE_TIMEOUT_MS=10000

# ---- Rate limiting and event dedup ----
# Per-user request ceilings (sustained abuse / runaway client).
# REQUESTS_PER_USER=300
# CONCURRENT_USERS=3
# How long a deduplicated event id is remembered, and how many are kept.
# EVENT_DEDUP_TTL_MS=600000
# EVENT_DEDUP_MAX=10000
# Sliding window used to detect an event reject storm.
# EVENT_REJECT_LOG_WINDOW_MS=60000
# Cached automation-rule evaluation window; shorter means more DB reads.
# AUTOMATION_CACHE_TTL_MS=30000

# Server process timezone (IANA). Affects cron/backup scheduling, not reporting.
# TZ=Africa/Cairo
# Path checked for free space before a backup runs.
# MONITOR_DISK_PATH=/

# Load test harness (npm run test:load). Never enabled in production.
# LOAD_TEST_URL=http://localhost:7000/api/health
# TEST_DURATION=30

# Optional overrides
# LOG_LEVEL=info
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# MONGODUMP_PATH=mongodump
# BACKUP_DIR=./backups
# FRONTEND_URL=http://localhost:5173
# Site-admin panel IP allowlist (comma-separated IPs/CIDRs). Restricts WRITE requests
# to /api/site/** (reads + site auth/2FA always pass). Empty = allowlist disabled.
# Mergeable at runtime via the `allowedSiteIps` PlatformSetting. Examples:
# ALLOWED_SITE_IPS=203.0.113.10,198.51.100.0/24

# SMTP Configuration for email OTP (required for secure recovery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@dentalos.com

# Security alerting (optional but recommended)
# Slack webhook for security alerts
SLACK_SECURITY_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# Email for security alerts (receives alerts on recovery completion)
SECURITY_ALERT_EMAIL=security@yourcompany.com
