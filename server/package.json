{
  "name": "dental-clinic-server",
  "version": "1.0.0",
  "description": "Dental OS API",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "migrate": "node -e \"import('./migrations/runner.js').then(m => m.runMigrations()).then(() => process.exit(0)).catch(e => { console.error(e); process.exit(1); })\"",
    "check": "node --check app.js && node --check server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:performance": "vitest run __tests__/performance",
    "test:security": "vitest run __tests__/security",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "load-test": "node scripts/load-test.js",
    "load-test:heavy": "CONCURRENT_USERS=50 REQUESTS_PER_USER=200 node scripts/load-test.js",
    "security-scan": "node scripts/security-scan.js",
    "monitor:health": "curl -s http://localhost:7000/api/health | jq .",
    "monitor:metrics": "curl -s http://localhost:7000/api/metrics | jq ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.3",
    "multer": "^2.2.0",
    "node-cron": "^4.5.0",
    "nodemailer": "^9.0.3",
    "otplib": "^13.4.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^5.0.0",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "whatsapp-web.js": "^1.34.7",
    "zod": "^4.4.3"
  }
}